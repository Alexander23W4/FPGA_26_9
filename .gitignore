# =============================================================================
#  FPGA_26_9  ——  .gitignore
# =============================================================================
#  原则：源码入库，生成物不入库。
#        Vivado / Vitis 的工程目录动辄几百 MB、上千文件，
#        全部放在 build/ 下并整体忽略；工程由 scripts/ 里的脚本重建。
# =============================================================================

# ============================ Vivado 生成物 ==================================
# 这些目录可能出现在任何位置（不只在 build/ 下）
.Xil/
*.Xil/
*.runs/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.gen/
*.jou
*.log
vivado*.jou
vivado*.log
webtalk*.jou
webtalk*.log
usage_statistics_webtalk.*
*.str
*.pb
hw_export/

# 位流与产物
*.bit
*.bin
*.ltx
*.xsa
*.hdf
*.dcp
*.mcs
*.prm
*.rpt
*.rpx

# ============================ Vitis 工作区 ==================================
# ★ csrc/ 就是 Vitis 工作区（不是 build/）。csrc/<组件名>/ 由 scripts 自动生成：
#     csrc/<平台名>/     平台 + BSP + FSBL   —— 生成物，忽略
#     csrc/<应用名>/src/ 你的 C 源码          —— 入库
#   只入库组件的描述文件和 src/ 下的源码，其余全部忽略。
csrc/**
!csrc/.gitkeep
!csrc/*/
!csrc/*/src/
!csrc/*/src/**
!csrc/*/vitis-comp.json
# src/ 里 Vitis 生成的辅助文件
csrc/*/src/.compile_commands
csrc/*/src/compile_commands.json
csrc/*/src/.clangd/

# 旧位置的 Vitis 工作区（如还残留）
vitis_workspace/
.metadata/
RemoteSystemsTempFiles/
IDE.log
.analytics/
*.elf
*.objectlist
_ide/
.sdk/
Debug/
Release/

# ============================ 仿真 ==========================================
work/
transcript
vsim.wlf
vsim.wlt
*.vstf
modelsim.ini
xsim.dir/
*.wdb
*.vcd
*.fst
*.ghw

# ============================ 构建输出 ======================================
build/**
!build/.gitkeep

# ============================ 编辑器 / 系统 =================================
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
~$*
.DS_Store

# ============================ Python =======================================
__pycache__/
*.pyc
.venv/
venv/
